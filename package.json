{
  "name": "@serenity-ui/react",
  "version": "0.2.0",
  "private": false,
  "description": "Open-source React components and framework-independent design tokens for SaaS and dashboards.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "tokens/serenity-theme.css",
    "tokens/figma-tokens.json",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "docs",
    "LICENSE"
  ],
  "main": "./dist/serenity-ui.js",
  "module": "./dist/serenity-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/serenity-ui.js"
    },
    "./styles.css": "./dist/serenity-ui.css",
    "./theme.css": "./tokens/serenity-theme.css",
    "./tokens.json": "./tokens/figma-tokens.json",
    "./styles-no-preflight.css": "./dist/serenity-ui-no-preflight.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "tokens": "node tokens/generate.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens && npm run typecheck && vite build --config vite.library.config.ts && vite build --config vite.styles.config.ts && tsc -p tsconfig.build.json",
    "build:workshop": "vite build && node scripts/check-public-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "npm run build && npm run test && npm run build:workshop",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "pack:local": "npm pack",
    "prepack": "npm run build",
    "check:public": "npm run build:workshop && node scripts/check-public-runtime.mjs",
    "example:integration": "npm run build && node examples/integration/dev.mjs",
    "test:integration": "playwright test --config playwright.integration.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.3.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PolariSystem/sui-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/PolariSystem/sui-design-system/issues"
  }
}
